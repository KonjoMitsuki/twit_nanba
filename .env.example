# =============================================================================
# X Art Analytics System - 環境変数設定
# =============================================================================
# このファイルをコピーして .env を作成し、各値を設定してください。
#   cp .env.example .env

# --- Notion API ---
# Notion Integration Token (https://www.notion.so/my-integrations で取得)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 作品マスターDB (Art Works) のデータベースID
ARTWORKS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 時系列メトリクスDB (Metrics Snapshots) のデータベースID
METRICS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Playwright Auth ---
# 認証セッションファイルのパス (setup_auth.py で生成)
X_AUTH_STATE_PATH=./auth_state.json

# --- Auto-Detection ---
# 新着イラスト自動検知: 監視対象の X スクリーンネーム（@ なし）
X_SCREEN_NAME=your_screen_name
